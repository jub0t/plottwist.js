{
  "name": "plottwist",
  "version": "0.0.1",
  "description": "Isometric, animated, interactive charts for the web.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./geo/countries": {
      "types": "./types/geo/countries.d.ts",
      "import": "./src/geo/countries.js"
    }
  },
  "files": [
    "src",
    "types",
    "dist"
  ],
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "showcase": "node scripts/build-showcase.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:visual": "node test/visual/run.js",
    "test:types": "tsc -p test/types",
    "build": "node scripts/build.js",
    "prepublishOnly": "npm test && npm run test:types && npm run build"
  },
  "keywords": [
    "chart",
    "isometric",
    "3d",
    "data-visualization",
    "canvas",
    "animation"
  ],
  "author": "Jareer",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "types": "./types/index.d.ts",
  "unpkg": "dist/plottwist.iife.min.js",
  "jsdelivr": "dist/plottwist.iife.min.js",
  "sideEffects": false
}
